{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stonevora",
  "version": "0.1.0",
  "identifier": "com.stonevora.erp",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stonevora ERP",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/server": "server"
    },
    "externalBin": ["binaries/node"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
